# مجلد android بالكامل: يُولَّد عبر flutter create (راجع README) ولا يُرفَع للمستودع
# لضمان توافقه الدائم مع نسخة Flutter/Gradle/AGP المستخدمة عند البناء.
/android/

# Android (تبقى فعّالة إن قرر أحدهم لاحقاً رفع نسخة مخصّصة من android/)
android/**/gradle-wrapper.jar
android/.gradle
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/**/GeneratedPluginRegistrant.java
key.properties
*.jks
*.keystore

# iOS
ios/Flutter/.last_build_id
ios/Pods/
ios/.symlinks/

# Firebase (لا تُرفع مفاتيح حساسة)
# ملاحظة: lib/firebase_options.dart مرفوع عمداً (نسخة placeholder آمنة) —
# سيستبدله flutterfire configure بالقيم الحقيقية لمشروعك عند ربط Firebase.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
functions/node_modules/
functions/.env

# Coverage
coverage/

# ملفات مولَّدة تلقائياً (flutter gen-l10n) — تُعاد توليدها في كل بناء
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

